<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">
        <TextView android:id="@+id/welcomeTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Bienvenido al Quiz" android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" android:gravity="center" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/welcomeUser" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" app:layout_constraintTop_toBottomOf="@id/welcomeTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/instructions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Instrucciones: cada quiz tiene 5 preguntas de opción múltiple. Selecciona una respuesta para cada pregunta y luego envíalo para conocer tu puntaje." app:layout_constraintTop_toBottomOf="@id/welcomeUser" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/categoryLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Elige un tipo de quiz" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/instructions" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <Button android:id="@+id/generalKnowledgeButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Cultura general" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/categoryLabel" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <Button android:id="@+id/scienceButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Ciencia" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/generalKnowledgeButton" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <Button android:id="@+id/sportsButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Deportes" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/scienceButton" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <Button android:id="@+id/historyButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Historia" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/sportsButton" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/selectedCategoryText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tipo seleccionado: ninguno" android:gravity="center" app:layout_constraintTop_toBottomOf="@id/historyButton" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/difficultyLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Nivel de dificultad" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/selectedCategoryText" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <RadioGroup android:id="@+id/difficultyGroup" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/easyRadio" app:layout_constraintTop_toBottomOf="@id/difficultyLabel" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <RadioButton android:id="@+id/easyRadio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fácil" />
            <RadioButton android:id="@+id/hardRadio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="Difícil" />
        </RadioGroup>
        <Button android:id="@+id/startQuizButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Comenzar quiz" app:layout_constraintTop_toBottomOf="@id/difficultyGroup" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <Button android:id="@+id/logoutButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Cerrar sesión" app:layout_constraintTop_toBottomOf="@id/startQuizButton" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
