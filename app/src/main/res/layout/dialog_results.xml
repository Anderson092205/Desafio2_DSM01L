<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_dialog_rounded">

    <ImageView
        android:id="@+id/imgResultBadge"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_check"
        android:padding="12dp"
        android:background="@drawable/bg_icon_circle"
        app:tint="@color/success" />

    <TextView
        android:id="@+id/txtResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="¡Quiz Finalizado!"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtResultCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Kotlin y Desarrollo Android"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Score Circle / Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp"
        android:background="@color/primary_light"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/txtScorePercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="@color/primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtScoreFraction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="5 de 5 preguntas correctas"
            android:textColor="@color/primary_dark"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtResultMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡Felicidades! Has respondido correctamente todas las preguntas."
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Action 1: Dedicated Button to View / Review Questions -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogReviewQuestions"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/primary"
        android:text="Visualizar Preguntas"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_check"
        app:iconTint="@color/white" />

    <!-- Actions 2 & 3: Reset or Change Quiz -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogResetQuiz"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Reiniciar Quiz"
            android:textColor="@color/primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/primary"
            app:strokeColor="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogChangeQuiz"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Otro Quiz"
            android:textColor="@color/text_secondary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/surface_card_stroke" />
    </LinearLayout>

</LinearLayout>
